# ============================================================
#  SLO LEAD ENGINE — CONFIG TEMPLATE
#  Copy this file to  config.env  and fill in your real values.
#  A value still wrapped in [ ] is treated as UNSET (ignored).
#  Paste keys with NO brackets and NO quotes, e.g.:  GOOGLE_PLACES_API_KEY=AIza...
# ============================================================

# REQUIRED for live lead discovery.
# Get one at https://console.cloud.google.com  (enable "Places API", add billing).
GOOGLE_PLACES_API_KEY=[paste your Google Places API key here]

# OPTIONAL — powers verification Stages 2 & 3.  https://serpapi.com
SERPAPI_KEY=[optional - paste SerpAPI key or leave this]

# Shown on the invoices the dashboard generates:
AGENCY_NAME=Central Coast Web Studio
AGENCY_EMAIL=[your@email.com]
AGENCY_PHONE=[your phone]
